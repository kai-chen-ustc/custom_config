#!/bin/bash
# Forward a dedicated key without copying it to the remote host.
set -e

usage() {
    echo "Usage: sshk [--key path] [ssh options] <host|user@ip> [ssh options] [command ...]"
    echo "       sshk dev-server --key ~/.ssh/work_key -L 8080:localhost:8080"
    echo "Default key: ${GIT_KEY_PATH:-auto (~/.ssh/id_ed25519, then ~/.ssh/id_rsa)}"
    echo "--key selects the forwarded key; SSH -i selects the login key."
    echo "--hc enables non-interactive hc transport and a stable remote agent socket."
}

GIT_KEY_PATH="${GIT_KEY_PATH:-}"
TARGET_HOST=
HC_MODE=0
ssh_args=()
remote_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --help) usage; exit 0 ;;
        --hc) HC_MODE=1; shift ;;
        --key)
            if [ $# -lt 2 ] || [ -z "$2" ]; then
                echo "Error: --key requires a path" >&2
                exit 1
            fi
            GIT_KEY_PATH="$2"
            shift 2
            ;;
        --)
            ssh_args+=("$1")
            shift
            if [ -z "$TARGET_HOST" ] && [ $# -gt 0 ]; then
                TARGET_HOST=$1
                ssh_args+=("$1")
                shift
            fi
            remote_args=("$@")
            break
            ;;
        -*)
            # Parse one option cluster; its value may be attached or the next word.
            option=$1
            ssh_args+=("$1")
            shift
            OPTIND=1
            while getopts ':46AaCfGgKkMNnqsTtVvXxYyB:b:c:D:E:e:F:I:i:J:L:l:m:O:o:P:p:Q:R:S:W:w:' flag "$option"; do
                case "$flag" in
                    :)
                        if [ $# -eq 0 ]; then
                            echo "Error: -$OPTARG requires a value" >&2
                            exit 1
                        fi
                        ssh_args+=("$1")
                        shift
                        ;;
                    \?) echo "Error: unknown SSH option -$OPTARG" >&2; exit 1 ;;
                esac
            done
            ;;
        *)
            if [ -n "$TARGET_HOST" ]; then
                remote_args=("$@")
                break
            fi
            TARGET_HOST="$1"
            ssh_args+=("$1")
            shift
            ;;
    esac
done
if [ -z "$TARGET_HOST" ]; then
    usage >&2
    exit 1
fi

if [ "$HC_MODE" = 1 ]; then
    if [ ${#remote_args[@]} -eq 0 ]; then
        echo "Error: --hc requires a remote command (normally supplied by hc --via)" >&2
        exit 1
    fi
    # OpenSSH joins command arguments with spaces. Preserve that behavior, then
    # quote the entire command as one argument to the remote bootstrap shell.
    shell_quote() {
        local value=$1
        printf '%s' "'"
        while [[ $value == *"'"* ]]; do
            printf '%s' "${value%%\'*}" "'\\''"
            value=${value#*\'}
        done
        printf "%s'" "$value"
    }
    bootstrap=$(cat <<'REMOTE'
set -eu
if [ -z "${SSH_AUTH_SOCK:-}" ] || [ ! -S "$SSH_AUTH_SOCK" ]; then
    echo "sshk --hc: no forwarded SSH agent on the remote host" >&2
    exit 1
fi
mkdir -p "$HOME/.ssh"
link=$HOME/.ssh/hc-forwarded-agent.sock
if [ -d "$link" ] || { [ -e "$link" ] && [ ! -L "$link" ]; }; then
    echo "sshk --hc: refusing to replace a non-symlink: $link" >&2
    exit 1
fi
# Publish atomically; leave the link on disconnect so existing shells recover
# when the next connection replaces it. One forwarding connection per account.
scratch=$(mktemp -d "$HOME/.ssh/.hc-agent.XXXXXX")
trap 'rm -f "$scratch/socket"; rmdir "$scratch"' 0
ln -s "$SSH_AUTH_SOCK" "$scratch/socket"
mv -f "$scratch/socket" "$link"
rmdir "$scratch"
trap - 0
exec sh -c "$1"
REMOTE
)
    remote_args=("sh -c $(shell_quote "$bootstrap") sshk-hc $(shell_quote "${remote_args[*]}")")
    ssh_args=(-T -o BatchMode=yes -o ConnectTimeout=10 "${ssh_args[@]}")
fi
ssh_args+=("${remote_args[@]}")
if [ -z "$GIT_KEY_PATH" ]; then
    for candidate in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa"; do
        if [ -f "$candidate" ] && [ -r "$candidate" ]; then
            GIT_KEY_PATH="$candidate"
            break
        fi
    done
fi
if [ -z "$GIT_KEY_PATH" ]; then
    echo "Error: no default key found; use --key path or set GIT_KEY_PATH" >&2
    exit 1
fi
if [ ! -f "$GIT_KEY_PATH" ] || [ ! -r "$GIT_KEY_PATH" ]; then
    echo "Error: key is not a readable file: $GIT_KEY_PATH" >&2
    exit 1
fi

# OpenSSH owns the agent lifecycle; this shell only restores the tmux label.
echo ">>> Starting temporary SSH agent..." >&2
cleanup() {
    if [ -n "${TMUX_PANE:-}" ]; then
        tmux set-option -pu -t "$TMUX_PANE" @ssh_alias 2>/dev/null || :
    fi
}
trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

ssh-agent sh -ec '
    key=$1
    host=$2
    hc_mode=$3
    shift 3
    echo ">>> Using key: $key" >&2
    if [ "$hc_mode" = 1 ]; then
        # hc carries a byte protocol on stdin; never read it for a passphrase.
        SSH_ASKPASS_REQUIRE=force SSH_ASKPASS=/usr/bin/false ssh-add "$key" </dev/null
    else
        ssh-add "$key"
    fi
    echo ">>> Connecting to $host with agent forwarding enabled..." >&2
    if [ -n "${TMUX_PANE:-}" ]; then
        tmux set-option -p -t "$TMUX_PANE" @ssh_alias "$host" 2>/dev/null || :
    fi
    exec ssh -A -o "IdentityAgent=$SSH_AUTH_SOCK" -o "ForwardAgent=$SSH_AUTH_SOCK" -o AddKeysToAgent=no -S none "$@"
' sshk "$GIT_KEY_PATH" "$TARGET_HOST" "$HC_MODE" "${ssh_args[@]}"
