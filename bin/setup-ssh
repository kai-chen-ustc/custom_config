#!/bin/bash
# Optional shared OpenSSH configuration. Compatible with macOS Bash 3.2.
set -euo pipefail
umask 077

usage() {
    cat <<'EOF'
Usage: setup-ssh install|replace|status [--source /path/to/hosts.conf] [--mode link|copy]
  install  Create missing files; stop on conflicts. An identical setup is a no-op.
  replace  Back up existing files before replacing them. Never changes config.local.
  status   Inspect the current setup without changing it; --source compares copies.
Without --source, install/replace offer common locations in an interactive terminal.
Default mode: link; copy for Windows-mounted sources on WSL.
EOF
}
fail() { echo "Error: $*" >&2; exit 1; }
exists() { [ -e "$1" ] || [ -L "$1" ]; }
SSH_DIR="$(cd -- "$HOME" && pwd -P)/.ssh"
SOURCE=
MODE=
ACTION=${1:-}
case "$ACTION" in
    install|replace|status) shift ;;
    -h|--help|'') usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
while [ "$#" -gt 0 ]; do
    case "$1" in
        --source|--mode)
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail "$1 requires a value"
            case "$1" in --source) SOURCE=$2 ;; --mode) MODE=$2 ;; esac
            shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) fail "Unknown option: $1" ;;
    esac
done
case "$MODE" in ''|link|copy) ;; *) fail 'Mode must be link or copy' ;; esac
command -v ssh >/dev/null || fail 'OpenSSH is required'
# shortcut: Include paths with glob characters are unsupported; add literal escaping when needed.
case "$SSH_DIR" in
    *\**|*\?*|*\[*|*\]*) fail 'SSH configuration directory cannot contain glob characters: * ? [ ]' ;;
esac

# Quote paths for OpenSSH, not for a shell. Never eval user-provided paths.
ssh_path() {
    local value=$1
    case "$value" in *$'\n'*|*$'\r'*) fail 'Paths cannot contain line breaks' ;; esac
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//%/%%}
    printf '"%s"' "$value"
}
entry() {
    printf '%s\n' '# Shared SSH entry point generated by custom_config/bin/setup-ssh.'
    printf 'Include '; ssh_path "$SSH_DIR/config.local"; printf '\nHost *\n    Include '
    ssh_path "$1"; printf '\n'
}
same_entry() {
    [ -f "$SSH_DIR/config" ] && [ ! -L "$SSH_DIR/config" ] &&
        cmp -s "$SSH_DIR/config" <(entry "$SSH_DIR/config.shared")
}
normalize_source() {
    case "$SOURCE" in '~/'*) SOURCE="$HOME/${SOURCE#\~/}" ;; esac
    [ -f "$SOURCE" ] && [ -r "$SOURCE" ] || fail "Shared source is not a readable file: $SOURCE"
    [ ! -L "$SOURCE" ] || fail 'Use the actual shared source file, not a symbolic link'
    SOURCE=$(cd -- "$(dirname -- "$SOURCE")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$SOURCE")")
    # A source inside .ssh could be replaced by this operation or form a loop.
    case "$SOURCE" in "$SSH_DIR"/*) fail 'Keep the shared source outside ~/.ssh' ;; esac
}
select_source() {
    local root candidate answer i
    local candidates=()
    [ -t 0 ] || fail 'Use --source for non-interactive installation'
    for root in "$HOME/Seafile/server-sync" "$HOME/server-sync" \
        "$HOME/projects/server-sync" "$HOME/Projects/server-sync"; do
        candidate="$root/config/ssh/hosts.conf"
        if [ -f "$candidate" ] && [ -r "$candidate" ]; then
            # Resolve parent aliases and deduplicate by file identity, including case aliases.
            candidate=$(cd -- "$(dirname -- "$candidate")" && printf '%s/hosts.conf' "$(pwd -P)")
            for i in "${candidates[@]+${candidates[@]}}"; do
                if [ "$i" -ef "$candidate" ]; then candidate=; break; fi
            done
            [ -z "$candidate" ] || candidates+=("$candidate")
        fi
    done
    if [ "${#candidates[@]}" -eq 1 ]; then
        echo "Shared source: ${candidates[0]}"
        answer=
        read -r -p 'Use this shared configuration? [y/N] ' answer || :
        case "$answer" in y|Y|yes|YES) SOURCE=${candidates[0]}; return ;; esac
    else
        i=0
        for candidate in "${candidates[@]+${candidates[@]}}"; do
            i=$((i + 1)); printf '%s) %s\n' "$i" "$candidate"
        done
        [ "$i" -gt 0 ] || echo 'No shared configuration found in common locations.'
    fi
    answer=
    read -r -p 'Enter a source file path or candidate number (Enter skips): ' answer || :
    [ -n "$answer" ] || { echo 'Shared SSH configuration skipped.'; exit 0; }
    case "$answer" in
        *[!0-9]*) SOURCE=$answer ;;
        *)
            # Compare strings instead of arithmetic on untrusted numeric input.
            i=0
            for candidate in "${candidates[@]+${candidates[@]}}"; do
                i=$((i + 1)); if [ "$answer" = "$i" ]; then SOURCE=$candidate; break; fi
            done
            [ -n "$SOURCE" ] || fail 'Invalid candidate number' ;;
    esac
}
choose_mode() {
    [ -z "$MODE" ] || return 0
    MODE=link
    case "$SOURCE" in
        /mnt/[a-zA-Z]/*)
            if [ "$(uname -s)" = Linux ] && {
                [ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ] ||
                    { [ -r /proc/version ] && grep -qi microsoft /proc/version; }
            }; then MODE=copy; fi ;;
    esac
}
same_shared() {
    if [ "$MODE" = link ]; then
        [ -L "$SSH_DIR/config.shared" ] && [ -f "$SSH_DIR/config.shared" ] &&
            [ "$(readlink "$SSH_DIR/config.shared")" = "$SOURCE" ]
    else
        [ -f "$SSH_DIR/config.shared" ] && [ ! -L "$SSH_DIR/config.shared" ] &&
            cmp -s "$SOURCE" "$SSH_DIR/config.shared"
    fi
}
validate() {
    # -G parses configuration without opening a connection. Disable canonical DNS lookups.
    ssh -T -G -F "$1" -o CanonicalizeHostname=no shared-config-check.invalid >/dev/null
}

if [ "$ACTION" = status ]; then
    if ! exists "$SSH_DIR/config" && ! exists "$SSH_DIR/config.shared"; then
        echo 'Shared SSH configuration is not installed.'; exit 1
    fi
    same_entry || fail 'Conflict: existing SSH entry differs from the generated shared entry'
    if [ -L "$SSH_DIR/config.shared" ]; then
        echo "Mode: link; source: $(readlink "$SSH_DIR/config.shared")"
        [ -f "$SSH_DIR/config.shared" ] || fail 'Shared configuration link is broken'
        MODE=${MODE:-link}
    elif [ -f "$SSH_DIR/config.shared" ]; then
        echo 'Mode: copy (pass --source to compare against the shared source).'
        MODE=${MODE:-copy}
    else
        fail 'Shared configuration file is missing or is not a regular file'
    fi
    if [ -n "$SOURCE" ]; then
        normalize_source; choose_mode
        same_shared || fail 'Source, mode, or copy differs; use replace to apply it with a backup'
    fi
    validate "$SSH_DIR/config" || fail 'Installed SSH configuration does not parse'
    echo 'Shared SSH configuration is configured.'
    exit 0
fi

[ -n "$SOURCE" ] || select_source
normalize_source
choose_mode
echo "Shared source: $SOURCE"
echo "Mode: $MODE"
[ ! -L "$SSH_DIR" ] || fail '~/.ssh must be a real directory, not a symbolic link'
if exists "$SSH_DIR" && [ ! -d "$SSH_DIR" ]; then fail '~/.ssh is not a directory'; fi
if same_entry && same_shared; then
    validate "$SSH_DIR/config" || fail 'Installed SSH configuration does not parse'
    echo 'Shared SSH configuration is already configured; nothing changed.'
    exit 0
fi
for name in config config.shared; do
    if exists "$SSH_DIR/$name"; then
        [ ! -d "$SSH_DIR/$name" ] || fail "Refusing to replace directory: $SSH_DIR/$name"
        [ "$ACTION" = replace ] || fail "Conflict: $SSH_DIR/$name already exists; use replace to back it up first"
    fi
done
if exists "$SSH_DIR/config.local"; then
    [ -f "$SSH_DIR/config.local" ] && [ -r "$SSH_DIR/config.local" ] ||
        fail 'config.local must be a readable file; it is never replaced'
fi

# The lock prevents two instances from installing over each other. No persistent state.
mkdir -p "$SSH_DIR"
LOCK="$SSH_DIR/.setup-ssh.lock"
mkdir -m 700 "$LOCK" 2>/dev/null || fail 'Another setup-ssh operation is running (or a stale .setup-ssh.lock remains)'
STAGE=
BACKUP=
DID_CONFIG=0
DID_SHARED=0
cleanup() {
    local code=$?
    trap - EXIT HUP INT TERM
    if { [ "$DID_CONFIG" = 1 ] || [ "$DID_SHARED" = 1 ]; } && [ "$code" -ne 0 ]; then
        echo 'Installation failed; restoring previous SSH files.' >&2
        for name in config config.shared; do
            case "$name" in
                config) [ "$DID_CONFIG" = 1 ] || continue ;;
                config.shared) [ "$DID_SHARED" = 1 ] || continue ;;
            esac
            if ! rm -f "$SSH_DIR/$name"; then
                echo "Cannot restore $SSH_DIR/$name; recover it from $BACKUP" >&2
                continue
            fi
            if [ -n "$BACKUP" ] && exists "$BACKUP/$name"; then
                cp -Pp "$BACKUP/$name" "$SSH_DIR/$name" || echo "Restore failed: $BACKUP/$name" >&2
            fi
        done
    fi
    [ -z "$STAGE" ] || rm -rf "$STAGE"
    rmdir "$LOCK" || :
    exit "$code"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM
STAGE=$(mktemp -d "$SSH_DIR/.setup-ssh.XXXXXX")
entry "$SSH_DIR/config.shared" > "$STAGE/config"
if [ "$MODE" = link ]; then
    ln -s "$SOURCE" "$STAGE/config.shared"
else
    cp "$SOURCE" "$STAGE/config.shared"
    chmod 600 "$STAGE/config.shared"
fi
entry "$STAGE/config.shared" > "$STAGE/validation"
validate "$STAGE/validation" || fail 'New SSH configuration does not parse; no existing files were changed'

# Recheck after acquiring the lock; default installation never overwrites a target.
for name in config config.shared; do
    if exists "$SSH_DIR/$name"; then
        [ ! -d "$SSH_DIR/$name" ] || fail "Refusing to replace directory: $SSH_DIR/$name"
        [ "$ACTION" = replace ] || fail "Conflict: $SSH_DIR/$name appeared during installation"
    fi
done
if [ "$ACTION" = replace ] && { exists "$SSH_DIR/config" || exists "$SSH_DIR/config.shared"; }; then
    BACKUP=$(mktemp -d "$HOME/.ssh-config-backup-$(date +%Y%m%d-%H%M%S).XXXXXX")
    echo "Backup directory: $BACKUP"
    for name in config config.shared; do
        if exists "$SSH_DIR/$name"; then
            cp -Pp "$SSH_DIR/$name" "$BACKUP/$name"
            if [ -L "$SSH_DIR/$name" ] && [ -f "$SSH_DIR/$name" ]; then
                cp -pL "$SSH_DIR/$name" "$BACKUP/$name.resolved"
            fi
        fi
    done
    echo "Previous SSH files backed up to: $BACKUP"
fi
chmod 700 "$SSH_DIR"
if [ "$ACTION" = install ]; then
    # Hard-link the staged entry with no overwrite; -P preserves the staged symlink.
    ln -P "$STAGE/config.shared" "$SSH_DIR/config.shared"
    DID_SHARED=1
    ln "$STAGE/config" "$SSH_DIR/config"
    DID_CONFIG=1
else
    mv -f "$STAGE/config.shared" "$SSH_DIR/config.shared"
    DID_SHARED=1
    mv -f "$STAGE/config" "$SSH_DIR/config"
    DID_CONFIG=1
fi
validate "$SSH_DIR/config" || fail 'Final SSH validation failed'
DID_CONFIG=0
DID_SHARED=0
echo 'Shared SSH configuration installed.'
