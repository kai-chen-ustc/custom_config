#!/bin/bash

# tmux or screen ?
(bin-exist tmux) && alias s=tmux || alias s=screen

alias find='noglob find'        # noglob for find
alias grep='grep -I --color=auto'
alias egrep='egrep -I --color=auto'
alias df='df -Th'
alias du='du -h'

alias gc="git clean -f -e '!*.orig'"

git-prune-local() {
    local current_worktree branch worktree_path worktree_status

    git fetch -p || return
    current_worktree=$(git rev-parse --show-toplevel) || return

    git for-each-ref \
        --format='%(refname:short) %(upstream:track)' \
        refs/heads | \
        awk '$NF == "[gone]" { print $1 }' | \
        while IFS= read -r branch; do
            worktree_path=$(git for-each-ref \
                --format='%(worktreepath)' \
                "refs/heads/$branch")

            if [[ -n "$worktree_path" ]]; then
                if [[ "$worktree_path" == "$current_worktree" ]]; then
                    echo "Skipping $branch: checked out in the current worktree." >&2
                    continue
                fi

                if ! worktree_status=$(git -C "$worktree_path" status --porcelain); then
                    echo "Skipping $branch: could not inspect worktree $worktree_path." >&2
                    continue
                fi

                if [[ -n "$worktree_status" ]]; then
                    echo "Skipping $branch: worktree $worktree_path has uncommitted changes." >&2
                    continue
                fi

                git worktree remove -- "$worktree_path" || continue
            fi

            git branch -D -- "$branch"
        done
}
